---
import { actions, isInputError } from 'astro:actions';
import BaseLayout from '../layouts/BaseLayout.astro';
import AnimatedHeading from '../components/AnimatedHeading.astro';
import FaqSection from '../components/FaqSection.astro';
import Icon from '../components/Icon.astro';
import { site } from '../data/site';
import { faqs } from '../data/content';
import { getServiceGroups } from '../lib/services';

// Rendered on demand: the form posts to the contact action and the result is shown here.
export const prerender = false;

const result = Astro.getActionResult(actions.contact);
const fieldErrors = isInputError(result?.error) ? result.error.fields : {};
const formError = result?.error && !isInputError(result.error) ? result.error.message : undefined;
const sent = result && !result.error ? result.data : undefined;
// Service pages link here with ?service=<id> to preselect it.
const preselected = Astro.url.searchParams.get('service');

// Each service listed once, under its main category.
const serviceGroups = (await getServiceGroups()).map((g) => ({
  label: g.title,
  services: g.services.filter((s) => s.data.category === g.id),
}));

const details = [
  { icon: 'contact-phone', label: site.phone.label, href: site.phone.href },
  { icon: 'whatsapp', label: 'Écrire sur WhatsApp', href: site.whatsapp.href },
  { icon: 'contact-mail', label: site.email.label, href: site.email.href },
  { icon: 'instagram', label: site.instagram.label, href: site.instagram.href },
  { icon: 'contact-pin', label: `Intervention ${site.area.phrase}` },
] as const;
---

<BaseLayout title="Devis de nettoyage à Bruxelles" description="Contactez Splashngo pour un devis de nettoyage à Bruxelles et dans ses environs : formulaire, téléphone ou WhatsApp. Réponse sous 48 heures.">
  <section class="section contact">
    <div class="container contact__inner">
      <div class="contact__left">
        <div class="contact__title" data-reveal>
          <AnimatedHeading as="h1" class="h1" text="Demandez votre devis" />
          <p class="lead">Décrivez votre besoin en quelques lignes. Nous revenons vers vous sous 48 heures avec un devis adapté.</p>
        </div>
        <ul class="contact__info" data-reveal data-zone="page-contact">
          {details.map((d) => (
            <li>
              {'href' in d
                ? <a href={d.href}><Icon name={d.icon} size={20} />{d.label}</a>
                : <span><Icon name={d.icon} size={20} />{d.label}</span>}
            </li>
          ))}
        </ul>
      </div>

      {sent ? (
        <div class="form contact__form contact__sent" role="status" data-form-sent={sent.service} data-reveal>
          <Icon name="check" size={48} />
          <h2 class="h4">Demande envoyée</h2>
          <p class="lead">Merci, nous avons bien reçu votre demande. Un e-mail de confirmation vient de vous être envoyé et nous revenons vers vous sous 48&nbsp;heures.</p>
          <p class="text-body">Pour aller plus vite, envoyez-nous quelques photos sur <a href={site.whatsapp.href}>WhatsApp</a>.</p>
        </div>
      ) : (
        <form class="form contact__form" method="post" action={actions.contact} data-reveal>
          {formError && <p class="form__alert" role="alert">{formError}</p>}
          <div class="form__fields">
            <label class="field">Nom complet<input type="text" name="name" placeholder="Prénom et nom" autocomplete="name" required maxlength="120" aria-invalid={fieldErrors.name ? 'true' : undefined} />
              {fieldErrors.name && <span class="field__error">{fieldErrors.name[0]}</span>}
            </label>
            <div class="form__row">
              <label class="field">E-mail<input type="email" name="email" placeholder="vous@exemple.be" autocomplete="email" required aria-invalid={fieldErrors.email ? 'true' : undefined} />
                {fieldErrors.email && <span class="field__error">{fieldErrors.email[0]}</span>}
              </label>
              <label class="field">Téléphone (facultatif)<input type="tel" name="phone" placeholder="+32 4xx xx xx xx" autocomplete="tel" aria-invalid={fieldErrors.phone ? 'true' : undefined} />
                {fieldErrors.phone && <span class="field__error">{fieldErrors.phone[0]}</span>}
              </label>
            </div>
            <label class="field">Service
              <select name="service" required>
                <option value="" disabled selected={!preselected}>Choisissez un service</option>
                {serviceGroups.map((g) => (
                  <optgroup label={g.label}>
                    {g.services.map((s) => <option value={s.id} selected={s.id === preselected}>{s.data.title}</option>)}
                  </optgroup>
                ))}
                <option value="autre">Autre demande</option>
              </select>
            </label>
            <label class="field">Message<textarea name="message" placeholder="Votre commune, la surface, l'accès, le délai souhaité…" required minlength="10" maxlength="5000" aria-invalid={fieldErrors.message ? 'true' : undefined}></textarea>
              {fieldErrors.message && <span class="field__error">{fieldErrors.message[0]}</span>}
            </label>
            <!-- Honeypot: hidden from people, filled by bots. -->
            <label class="form__trap" aria-hidden="true">Site web<input type="text" name="website" tabindex="-1" autocomplete="off" /></label>
          </div>
          <button class="btn-solid" type="submit">Envoyer ma demande</button>
          <p class="form__note">Vos informations servent uniquement à répondre à votre demande. <a href="/politique-de-confidentialite">Confidentialité</a></p>
        </form>
      )}
    </div>
  </section>

  <FaqSection {...faqs.contact} titleGap={14} />
</BaseLayout>


<style>
  .contact { padding-block: 235px 120px; }
  .contact__inner { display: flex; justify-content: space-between; }
  .contact__left { display: flex; flex-direction: column; justify-content: space-between; max-width: 540px; padding-right: 40px; }
  .contact__title { display: flex; flex-direction: column; gap: 16px; }
  .contact__info { display: flex; flex-direction: column; gap: 18px; padding: 0; list-style: none; }
  .contact__info :is(a, span) { display: flex; align-items: center; gap: 20px; font-size: 16px; font-weight: 500; line-height: 1.56; transition: color 0.3s; }
  .contact__info :global(svg) { flex: none; color: var(--color-accent); transition: color 0.3s; }
  .contact__info a:hover, .contact__info a:hover :global(svg) { color: var(--color-highlight); }
  .contact__form { max-width: 562px; }
  .form__trap { position: absolute; left: -9999px; }
  .form__alert { margin-bottom: 20px; padding: 14px 16px; border-radius: var(--radius-md); background: #fdecec; color: #8a1c1c; font-size: 15px; }
  .field__error { font-size: 14px; font-weight: 500; color: #b42318; }
  .field :global([aria-invalid='true']) { border-color: #b42318; }
  .form__note { margin-top: 14px; font-size: 13px; font-weight: 400; color: var(--color-muted); text-align: center; }
  .form__note a, .contact__sent a { color: var(--color-primary); text-decoration: underline; }
  .contact__sent { display: flex; flex-direction: column; align-items: flex-start; justify-content: center; gap: 16px; }
  .contact__sent :global(svg) { color: var(--color-accent); }

  @media (max-width: 1199.98px) {
    .contact { padding-block: 170px 90px; }
    .contact__left { flex: 1; }
    .contact__info { padding-top: 40px; }
    .contact__form { flex: 1; }
    .contact__form .form__fields { gap: 16px; }
  }
  @media (max-width: 767.98px) {
    .contact { padding-block: 120px 70px; }
    .contact__inner { flex-direction: column; gap: 40px; }
    .contact__left { justify-content: flex-start; gap: 24px; max-width: none; padding-right: 0; }
    .contact__info { gap: 16px; padding-top: 0; }
    .contact__form { max-width: none; }
    .contact__form .form__row { gap: 16px; }
  }
</style>
