---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import AnimatedHeading from '../components/AnimatedHeading.astro';
import Button from '../components/Button.astro';
import Icon from '../components/Icon.astro';
import ServiceCard from '../components/ServiceCard.astro';
import MaskedImage from '../components/MaskedImage.astro';
import HowItWorks from '../components/HowItWorks.astro';
import FaqSection from '../components/FaqSection.astro';
import { site } from '../data/site';
import { faqs } from '../data/content';
import { getServices } from '../lib/services';

import hero from '../assets/images/photos/panneaux-solaires.webp';
import vetted1 from '../assets/images/photos/vitres.webp';
import vetted2 from '../assets/images/photos/gouttieres.webp';
import arrow from '../assets/images/home/arrow.png';
import saveTime1 from '../assets/images/home/save-time-1.png';
import saveTime2 from '../assets/images/home/save-time-2.jpg';
import saveTime3 from '../assets/images/photos/bureaux-commerces.webp';
import reliable from '../assets/images/home/reliable.png';

const services = (await getServices()).slice(0, 6);

const reasons = [
  {
    title: 'Un seul contact pour tout',
    text: "Logement, vitres, gouttières, panneaux solaires ou bureaux : vous confiez tous vos besoins de nettoyage à la même équipe, avec un seul devis.",
    image: saveTime1, alt: "Nettoyage d'un évier de cuisine",
  },
  {
    title: 'Un devis clair sous 48 heures',
    text: "Vous savez exactement ce qui sera fait et à quel prix avant toute intervention. Pas de mauvaise surprise sur la facture.",
    image: saveTime2, alt: "Nettoyage d'un plan de travail",
  },
  {
    title: 'Particuliers et professionnels',
    text: "Nous intervenons chez les propriétaires et locataires comme pour les commerces, les entreprises et les syndics d'immeuble.",
    image: saveTime3, alt: "Nettoyage du sol d'un bureau avec une autolaveuse",
  },
];

const reliableList = [
  'Un devis précis avant toute intervention',
  'Du matériel et des produits adaptés à chaque surface',
  'Une intervention ponctuelle ou régulière',
  'Les gouttières et panneaux solaires, même en hauteur',
];
---

<BaseLayout header="dark">
  <!-- Hero ----------------------------------------------------------- -->
  <section class="section hero" data-zone="accueil">
    <div class="hero__bg" aria-hidden="true">
      <div class="hero__photo" data-parallax>
        <Image src={hero} alt="" widths={[800, 1200, hero.width]} sizes="100vw" quality={85} loading="eager" fetchpriority="high" />
      </div>
      <div class="hero__shade"></div>
      <div class="hero__blur"></div>
    </div>

    <div class="container">
      <div class="hero__content">
        <p class="hero__badge" data-reveal="down"><Icon name="check" size={20} /> Devis sous 48 heures, {site.area.phrase}</p>
        <div class="hero__main">
          <div class="hero__text">
            <div data-reveal style="--delay:0.2s">
              <AnimatedHeading as="h1" class="h1" text="Le nettoyage soigné, de l'intérieur jusqu'au toit" />
            </div>
            <p class="hero__lead" data-reveal style="--delay:0.3s">Remise en état, vitres, gouttières, panneaux solaires, bureaux&nbsp;: Splashngo intervient chez les particuliers et les professionnels.</p>
          </div>
          <Button href="/contact" label="Demander un devis" icon="mail-outline" />
        </div>
      </div>
    </div>
  </section>

  <!-- Services ------------------------------------------------------- -->
  <section class="section services edge-bottom">
    <div class="container services__inner">
      <div class="section-title" style="--max:548px" data-reveal>
        <AnimatedHeading class="h2" text="Nos services de nettoyage" />
        <p class="lead">Pour votre logement, vos extérieurs et vos locaux professionnels, en intervention ponctuelle ou régulière.</p>
      </div>
      <div class="services__grid">
        {services.map((service) => <ServiceCard service={service} tone="white" />)}
      </div>
      <div class="services__more">
        <Button href="/services" label="Voir tous les services" icon="arrow-left" class="btn--next" />
      </div>
    </div>
  </section>

  <!-- Care ----------------------------------------------------------- -->
  <section class="section vetted">
    <div class="container vetted__inner">
      <div class="vetted__left" data-reveal style="--from-y:0px">
        <MaskedImage class="vetted__img1" src={vetted1} alt="Nettoyage de vitres avec une raclette" shape="rows-5-a" sizes="(min-width: 768px) 427px, 100vw" />
      </div>
      <Image class="vetted__arrow" src={arrow} alt="" width={338} />
      <div class="vetted__right">
        <p class="h5 vetted__text" data-reveal>Chaque intervention commence par un devis clair et se termine par un contrôle du travail fait. Nous utilisons un matériel adapté à chaque surface, des vitres aux panneaux solaires, et nous respectons votre logement ou vos locaux comme si c'étaient les nôtres.</p>
        <div data-reveal style="--from-y:0px">
          <MaskedImage class="vetted__img2" src={vetted2} alt="Nettoyage d'une toiture et des gouttières au jet" shape="cols-5-a" sizes="(min-width: 768px) 540px, 100vw" />
        </div>
      </div>
    </div>
  </section>

  <!-- How it works --------------------------------------------------- -->
  <HowItWorks accent="accent" showStats />

  <!-- Why Splashngo -------------------------------------------------- -->
  <section class="section save-time" data-save-time>
    <div class="container save-time__inner">
      <div class="save-time__media shape" style="--shape:url('/shapes/cols-6-a.svg')" data-reveal>
        {reasons.map((item, i) => (
          <Image src={item.image} alt={item.alt} class:list={[i === 0 && 'is-active']} widths={[611, 1222]} sizes="(min-width: 1200px) 611px, 100vw" quality={85} />
        ))}
      </div>
      <div class="save-time__content">
        <div class="save-time__title" data-reveal>
          <AnimatedHeading class="h2" text="Pourquoi Splashngo" />
          <p class="lead">Un nettoyage bien fait, un interlocuteur joignable et un prix connu à l'avance.</p>
        </div>
        <div class="save-time__tabs" data-reveal>
          {reasons.map((item, i) => (
            <details name="save-time" open={i === 0}>
              <summary class="h6">{item.title}</summary>
              <p class="text-body">{item.text}</p>
            </details>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- Reliable ------------------------------------------------------- -->
  <section class="section reliable">
    <div class="container reliable__inner">
      <div class="reliable__content">
        <div class="reliable__title" data-reveal>
          <AnimatedHeading class="h2" text="Un travail soigné, sans surprise" />
          <p class="lead">Nous prenons le temps de comprendre votre besoin pour faire le bon travail du premier coup.</p>
        </div>
        <ul class="check-list" data-reveal>
          {reliableList.map((item) => <li><Icon name="check" />{item}</li>)}
        </ul>
      </div>
      <MaskedImage class="reliable__img" src={reliable} alt="Nettoyage d'un mur" shape="rows-5-b" sizes="(min-width: 1200px) 610px, 100vw" />
    </div>
  </section>

  <FaqSection id="faq" {...faqs.accueil} />
</BaseLayout>

<script>
  // "Pourquoi Splashngo": the open item decides which photo is shown.
  document.querySelectorAll<HTMLElement>('[data-save-time]').forEach((root) => {
    const items = [...root.querySelectorAll('details')];
    const images = [...root.querySelectorAll('.save-time__media img')];
    items.forEach((item, i) =>
      item.addEventListener('toggle', () => {
        if (item.open) images.forEach((img, j) => img.classList.toggle('is-active', j === i));
      }),
    );
  });
</script>

<style>
  /* Hero */
  .hero { padding-block: 265px 175px; color: var(--color-white); isolation: isolate; }
  .hero__bg {
    position: absolute; inset: 0 0 -1px; z-index: -1; overflow: hidden; background: var(--color-white);
    -webkit-mask: url('/shapes/hero-bottom.svg') bottom / cover no-repeat;
    mask: url('/shapes/hero-bottom.svg') bottom / cover no-repeat;
  }
  .hero__photo, .hero__photo img { position: absolute; inset: 0; width: 100%; height: 100%; }
  .hero__photo img { object-fit: cover; object-position: center top; }
  .hero__shade, .hero__blur { position: absolute; inset: 0 auto 0 0; width: 71%; }
  .hero__shade { background: linear-gradient(90deg, rgb(0 0 0 / 92%) 0%, rgb(0 0 0 / 0%) 85.6%); }
  .hero__blur {
    -webkit-backdrop-filter: blur(6px); backdrop-filter: blur(6px);
    -webkit-mask: linear-gradient(271deg, transparent 12%, #000 56%);
    mask: linear-gradient(271deg, transparent 12%, #000 56%);
  }
  .hero__content { display: flex; flex-direction: column; gap: 32px; max-width: 900px; }
  .hero__badge {
    display: inline-flex; align-items: center; gap: 8px; align-self: flex-start;
    padding: 6px 14px 6px 8px; border-radius: 100px; background: rgb(255 255 255 / 14%);
    -webkit-backdrop-filter: blur(10px); backdrop-filter: blur(10px);
    font-size: 15px; font-weight: 600;
  }
  .hero__badge :global(svg) { color: var(--color-accent); }
  .hero__main { display: flex; flex-direction: column; align-items: flex-start; gap: 36px; }
  .hero__text { display: flex; flex-direction: column; gap: 16px; width: 100%; }
  .hero__lead { max-width: 496px; font-size: 18px; line-height: 1.56; color: rgb(229 234 236 / 90%); }


  /* Services */
  .services {
    --edge-color: var(--color-surface); --bump: calc(100vw / 26);
    background: var(--color-surface); padding-block: var(--section-space);
  }
  .services__inner { display: flex; flex-direction: column; gap: 72px; }
  .services__grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; }
  .services__more { display: flex; justify-content: center; }
  .services__more :global(.btn--next .btn__icon) { rotate: 180deg; color: var(--color-accent); }

  /* Vetted cleaners */
  .vetted { padding-block: var(--section-space); }
  .vetted__inner { position: relative; display: flex; align-items: center; gap: 218px; }
  .vetted__left { flex: none; width: 427px; }
  .vetted__img1 { aspect-ratio: 1708 / 1412; rotate: -10.76deg; }
  .vetted__arrow { position: absolute; left: 538px; top: 172px; width: 169px; height: auto; translate: -50% -50%; rotate: 163deg; }
  .vetted__right { display: flex; flex-direction: column; gap: 84px; max-width: 628px; }
  .vetted__img2 { width: 540px; aspect-ratio: 1620 / 1281; rotate: 3.24deg; }
  /* Framer rotated these photos into place as they appeared. */
  :global(.js) .vetted__left[data-reveal] { rotate: 21.5deg; }
  :global(.js) .vetted__right [data-reveal]:has(.vetted__img2) { rotate: -9deg; opacity: 1; }
  :global(.js) .vetted [data-reveal] { transition-property: opacity, transform, rotate; }
  :global(.js) .vetted [data-reveal].is-in { rotate: 0deg; }

  /* Save your time */
  .save-time { padding-bottom: 140px; }
  .save-time__inner { display: flex; justify-content: space-between; align-items: center; max-width: 1176px; }
  .save-time__media { flex: none; width: 611px; aspect-ratio: 611 / 550; }
  .save-time__media img { position: absolute; inset: 0; opacity: 0; transition: opacity 0.6s var(--ease-out); }
  .save-time__media img:first-child, .save-time__media img.is-active { opacity: 1; }
  .save-time__content { display: flex; flex-direction: column; gap: 64px; max-width: 520px; padding-left: 32px; }
  .save-time__title { display: flex; flex-direction: column; gap: 24px; }
  .save-time__tabs details { padding: 18px 0; border-top: 1px solid var(--color-line); }
  .save-time__tabs details:last-child { border-bottom: 1px solid var(--color-line); }
  .save-time__tabs summary { cursor: pointer; list-style: none; }
  .save-time__tabs summary::-webkit-details-marker { display: none; }
  .save-time__tabs p { padding-top: 8px; }

    --edge-color: var(--color-surface); --bump: calc(100vw / 26);
    background: var(--color-surface); padding-block: 110px;
  }

  /* Reliable */
  .reliable { padding-block: var(--section-space); }
  .reliable__inner { display: flex; justify-content: space-between; align-items: center; }
  .reliable__content { display: flex; flex-direction: column; gap: 50px; max-width: 570px; padding-right: 40px; }
  .reliable__title { display: flex; flex-direction: column; gap: 24px; }
  .reliable__title p { max-width: 465px; }
  .reliable__img { flex: none; width: 610px; aspect-ratio: 2440 / 1872; }

  @media (max-width: 1199.98px) {
    .hero { padding-block: 180px 100px; }
    .hero__content { gap: 24px; max-width: 760px; }
    .services { --bump: 40.5px; }
    .services__inner { gap: 50px; }
    .services__grid { grid-template-columns: repeat(2, 1fr); }

    .vetted__inner { gap: 60px; }
    .vetted__left { width: 345px; }
    .vetted__arrow { left: 359px; top: 101px; width: 96px; }
    .vetted__right { gap: 40px; }
    .vetted__text { font-size: 18px; line-height: 1.52; letter-spacing: normal; }
    .vetted__img2 { width: 100%; }

    .save-time { padding-bottom: 80px; }
    .save-time__inner { flex-direction: column-reverse; align-items: stretch; gap: 40px; }
    .save-time__media { width: 100%; }
    .save-time__content { max-width: none; gap: 32px; padding-left: 0; }
    .save-time__tabs details { padding: 16px 0 15px; }


    .reliable__inner { flex-direction: column; align-items: stretch; gap: 50px; }
    .reliable__content { max-width: none; gap: 30px; padding-right: 0; }
    .reliable__img { width: 100%; }

  }

  @media (max-width: 767.98px) {
    .hero { padding-block: 110px 80px; }
    .hero__content { gap: 20px; }
    .hero__main { gap: 32px; }

    .services { --bump: 30.9px; }
    .services__inner { gap: 40px; }
    .services__grid { grid-template-columns: 1fr; }

    .vetted__inner { flex-direction: column; gap: 24px; }
    .vetted__left { width: 100%; }
    .vetted__img1, .vetted__img2 { rotate: none; }
    :global(.js) .vetted [data-reveal] { rotate: 0deg; }
    .vetted__arrow { display: none; }
    .vetted__right { gap: 24px; }

    .save-time { padding-bottom: 60px; }
    .save-time__inner { gap: 24px; }
    .save-time__content { gap: 24px; }


    .reliable__inner { gap: 32px; }
    .reliable__content { gap: 24px; }
    .reliable__img { aspect-ratio: 350 / 269; }

  }
</style>
