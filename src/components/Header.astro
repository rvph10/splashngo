---
import Icon from './Icon.astro';
import Button from './Button.astro';
import logo from '../assets/images/brand/logo.svg';
import { site, mainNav, socials } from '../data/site';
import { getServiceGroups } from '../lib/services';

interface Props {
  theme: 'dark' | 'light';
}
const { theme } = Astro.props;
// Each service listed once, under its main category.
const serviceGroups = (await getServiceGroups()).map((g) => ({
  ...g,
  services: g.services.filter((s) => s.data.category === g.id),
}));
const current = Astro.url.pathname.replace(/\.html$/, '').replace(/\/$/, '') || '/';
---

<header class="site-header" data-theme={theme} data-zone="entete">
  <div class="topbar">
    <div class="container topbar__inner">
      <div class="topbar__contact">
        <a href={site.phone.href}><Icon name="phone-outline" size={14} /> {site.phone.label}</a>
        <a href={site.email.href}><Icon name="mail-outline" size={14} /> {site.email.label}</a>
      </div>
      <ul class="topbar__socials">
        {socials.map((s) => (
          <li><a href={s.href} aria-label={s.label}><Icon name={s.icon} size={12} /></a></li>
        ))}
      </ul>
    </div>
  </div>

  <nav class="nav" aria-label="Navigation principale">
    <div class="container nav__bar">
      <a class="nav__logo" href="/" aria-label={`${site.name}, accueil`}>
        <img src={logo.src} alt="" width="176" height="38" />
      </a>

      <div class="nav__desktop">
        <ul class="nav__links">
          <li class="dropdown">
            <button class="nav__link dropdown__toggle" type="button" aria-expanded="false" aria-controls="services-menu">
              Services <Icon name="chevron-down" size={16} class="dropdown__chevron" />
            </button>
            <div class="dropdown__panel" id="services-menu">
              {serviceGroups.map((group) => (
                <ul>
                  <li><a class="dropdown__group" href={`/services#${group.id}`}>{group.title}</a></li>
                  {group.services.map((s) => <li><a class="nav__link" href={`/services/${s.id}`}>{s.data.title}</a></li>)}
                </ul>
              ))}
            </div>
          </li>
          {mainNav.map((l) => (
            <li>
              <a class="nav__link" href={l.href} aria-current={current === l.href ? 'page' : undefined}>{l.label}</a>
            </li>
          ))}
        </ul>
        <Button href="/contact" label="Demander un devis" icon="mail-outline" />
      </div>

      <button class="nav__toggle" type="button" aria-expanded="false" aria-controls="mobile-menu" aria-label="Ouvrir le menu">
        <span></span><span></span><span></span>
      </button>
    </div>

    <div class="nav__mobile container" id="mobile-menu">
      <ul>
        <li><a class="nav__link" href="/services">Services</a></li>
        {mainNav.map((l) => <li><a class="nav__link" href={l.href}>{l.label}</a></li>)}
        <li><a class="nav__link" href={site.phone.href}>{site.phone.label}</a></li>
      </ul>
    </div>
  </nav>
</header>

<script>
  const header = document.querySelector<HTMLElement>('.site-header')!;
  const toggle = header.querySelector<HTMLButtonElement>('.nav__toggle')!;
  const dropdown = header.querySelector<HTMLButtonElement>('.dropdown__toggle')!;

  toggle.addEventListener('click', () => {
    const open = toggle.getAttribute('aria-expanded') !== 'true';
    toggle.setAttribute('aria-expanded', String(open));
    toggle.setAttribute('aria-label', open ? 'Fermer le menu' : 'Ouvrir le menu');
    header.classList.toggle('is-open', open);
  });

  // Click/keyboard support for the hover dropdown (touch screens, keyboard users).
  dropdown.addEventListener('click', () => {
    dropdown.setAttribute('aria-expanded', String(dropdown.getAttribute('aria-expanded') !== 'true'));
  });
  document.addEventListener('click', (e) => {
    if (!dropdown.parentElement!.contains(e.target as Node)) dropdown.setAttribute('aria-expanded', 'false');
  });
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') dropdown.setAttribute('aria-expanded', 'false');
  });

  // Phone: the fixed header turns into the light bar once the page scrolls.
  const onScroll = () => header.classList.toggle('is-scrolled', window.scrollY > 10);
  onScroll();
  window.addEventListener('scroll', onScroll, { passive: true });
</script>

<style>
  .site-header {
    position: absolute; z-index: 50; top: 0; left: 0; right: 0;
    --nav-fg: var(--color-ink);
  }
  .site-header[data-theme='dark'] { --nav-fg: var(--color-white); }

  /* Top bar ---------------------------------------------------------- */
  .topbar { background: var(--color-accent); padding: 10px 30px; }
  .topbar__inner { display: flex; justify-content: space-between; align-items: center; gap: 10px; }
  .topbar__contact { display: flex; gap: 40px; }
  .topbar__contact a { display: flex; align-items: center; gap: 6px; font-size: 14px; font-weight: 600; line-height: 1.56; }
  .topbar__contact svg { margin-top: 2px; }
  .topbar__socials { display: flex; gap: 10px; padding: 0; list-style: none; }
  .topbar__socials a { display: block; padding: 4px; border-radius: 100px; transition: background-color 0.3s; }
  .topbar__socials a:hover, .topbar__socials a:focus-visible { background: var(--color-white); }

  /* Nav bar ---------------------------------------------------------- */
  .nav { padding: 22px 30px; color: var(--nav-fg); }
  .site-header[data-theme='light'] .nav {
    background: rgb(255 255 255 / 80%);
    -webkit-backdrop-filter: blur(20px); backdrop-filter: blur(20px);
  }
  .nav__bar { display: flex; justify-content: space-between; align-items: center; min-height: 61px; }
  .nav__logo img { width: 176px; height: 38px; object-fit: contain; }

  .nav__desktop { display: flex; align-items: center; gap: 40px; }
  .nav__links { display: flex; align-items: center; gap: 40px; padding: 0; list-style: none; }
  .nav__link {
    display: flex; align-items: center; gap: 6px; padding: 0; border: 0; background: none;
    font-size: 16px; font-weight: 500; line-height: 1.56; color: inherit; white-space: nowrap;
    transition: color 0.3s;
  }
  .nav__link:hover, .nav__link:focus-visible, .dropdown:hover .dropdown__toggle { color: var(--color-highlight); }

  /* "All Pages" dropdown */
  .dropdown { position: relative; }
  .dropdown__chevron { transition: transform 0.3s; }
  .dropdown__panel {
    position: absolute; top: 100%; left: 18px; display: flex; gap: 40px;
    margin-top: 22px; padding: 24px 32px 24px 24px;
    border-radius: 10px; background: var(--color-white); box-shadow: var(--shadow-soft);
    color: var(--color-ink);
    opacity: 0; visibility: hidden; transform: translateY(10px);
    transition: opacity 0.25s, transform 0.25s var(--ease-out), visibility 0.25s;
  }
  /* Invisible bridge so the panel stays open while the pointer travels to it. */
  .dropdown__panel::before { content: ''; position: absolute; left: 0; right: 0; bottom: 100%; height: 22px; }
  .dropdown__panel ul { display: flex; flex-direction: column; gap: 10px; padding: 0; list-style: none; }
  .dropdown__group { font-size: 14px; font-weight: 700; line-height: 1.56; text-transform: uppercase; letter-spacing: 0.04em; color: var(--color-muted); }
  .dropdown__group:hover, .dropdown__group:focus-visible { color: var(--color-highlight); }
  .dropdown:hover .dropdown__panel,
  .dropdown:focus-within .dropdown__panel,
  .dropdown__toggle[aria-expanded='true'] + .dropdown__panel { opacity: 1; visibility: visible; transform: none; }
  .dropdown:hover .dropdown__chevron,
  .dropdown__toggle[aria-expanded='true'] .dropdown__chevron { transform: rotate(180deg); }

  /* Hamburger + mobile menu (hidden on desktop) */
  .nav__toggle, .nav__mobile { display: none; }

  @media (max-width: 1199.98px) {
    .nav { padding: 16px 20px; }
    .nav__bar { min-height: 36px; }
    .nav__logo img { width: 167px; height: 36px; }
    .nav__desktop { display: none; }
    .site-header[data-theme='light'] .nav { box-shadow: var(--shadow-soft); }

    .nav__toggle {
      display: flex; flex-direction: column; justify-content: center; gap: 6px;
      width: 24px; height: 24px; padding: 0; border: 0; background: none;
    }
    .nav__toggle span {
      display: block; width: 24px; height: 2px; border-radius: 1px; background: var(--nav-fg);
      transition: transform 0.3s var(--ease-out), opacity 0.2s;
    }
    .is-open .nav__toggle span:nth-child(1) { transform: translateY(8px) rotate(45deg); }
    .is-open .nav__toggle span:nth-child(2) { opacity: 0; }
    .is-open .nav__toggle span:nth-child(3) { transform: translateY(-8px) rotate(-45deg); }

    .is-open .nav__mobile { display: flex; flex-direction: column; gap: 10px; padding: 30px 0 20px; }
    .nav__mobile ul { display: flex; flex-direction: column; align-items: flex-start; gap: 10px; padding: 0; list-style: none; }

    /* An open menu always uses the light style. */
    .site-header.is-open { --nav-fg: var(--color-ink); }
    .is-open .nav {
      background: rgb(255 255 255 / 80%); box-shadow: var(--shadow-soft);
      -webkit-backdrop-filter: blur(20px); backdrop-filter: blur(20px);
    }
  }

  @media (max-width: 767.98px) {
    .site-header { position: fixed; }
    .topbar { display: none; }
    .site-header.is-scrolled { --nav-fg: var(--color-ink); }
    .is-scrolled .nav {
      background: rgb(255 255 255 / 80%); box-shadow: var(--shadow-soft);
      -webkit-backdrop-filter: blur(20px); backdrop-filter: blur(20px);
    }
  }
</style>
