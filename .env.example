# Public address of this build. Preview link for the client, final domain in production.
SITE_URL=https://www.splashngo.be

# true for the client test link (noindex + robots.txt Disallow). false or empty in production.
PUBLIC_PREVIEW=false

# Resend (https://resend.com). The sender must use a domain verified in Resend.
RESEND_API_KEY=
CONTACT_FROM_EMAIL="Splashngo <devis@splashngo.be>"
# Business inbox (Zoho) that receives the requests
CONTACT_TO_EMAIL=

# Umami analytics (self-hosted). Leave empty to disable tracking.
# URL of the tracker script on your Umami server, e.g. https://stats.example.com/script.js
PUBLIC_UMAMI_SRC=
# Website ID shown in Umami > Settings > Websites
PUBLIC_UMAMI_WEBSITE_ID=
